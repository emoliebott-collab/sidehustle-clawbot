{
  "agentId": "user-clawbot",
  "database": {
    "path": "/app/data/openclaw.sqlite"
  },
  "auth": {
    "profiles": {
      "google:default": { "provider": "google", "mode": "api_key", "apiKey": "$GOOGLE_API_KEY" },
      "openai:default": { "provider": "openai", "mode": "api_key", "apiKey": "$OPENAI_API_KEY" },
      "anthropic:default": { "provider": "anthropic", "mode": "api_key", "apiKey": "$ANTHROPIC_API_KEY" }
    }
  },
  "match": {
    "channel": "telegram",
    "accountId": "default"
  },
  "security": {
    "elevated": "deny",
    "exec": "deny",
    "file": "deny"
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "$TELEGRAM_BOT_TOKEN",
      "allowFrom": [ "$TELEGRAM_OWNER_ID" ],
      "dmPolicy": "allowlist",
      "groupPolicy": "disabled"
    }
  },
  "gateway": {
    "mode": "remote",
    "auth": {
      "mode": "token"
    }
  },
  "model": {
    "primary": "${OPENCLAW_MODEL_ALIAS}",
    "fallbacks": []
  }
}
