{
  "agentId": "user-clawbot",
  "match": {
    "channel": "telegram",
    "accountId": "default"
  },
  "security": {
    "elevated": "deny",
    "exec": "deny",
    "file": "deny"
  },
  "channels": {
    "telegram": {
      "botToken": "$TELEGRAM_BOT_TOKEN", 
      "allowFrom": [ "$TELEGRAM_OWNER_ID" ], 
      "dmPolicy": "allowlist",
      "groupPolicy": "deny"
    }
  },
  "gateway": {
    "mode": "remote",
    "auth": {
      "mode": "token"
    }
  },
  "model": {
    "primary": "$OPENCLAW_MODEL_ALIAS",
    "fallbacks": []
  },
  "models": {
    "$OPENCLAW_MODEL_ALIAS": {
      "alias": "$OPENCLAW_MODEL_ALIAS"
    }
  }
}
