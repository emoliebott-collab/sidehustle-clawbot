{
  "auth": {
    "profiles": {
      "google:default": { "provider": "google", "mode": "api_key", "apiKey": "PLACEHOLDER_GOOGLE" },
      "openai:default": { "provider": "openai", "mode": "api_key", "apiKey": "PLACEHOLDER_OPENAI" },
      "anthropic:default": { "provider": "anthropic", "mode": "api_key", "apiKey": "PLACEHOLDER_ANTHROPIC" }
    }
  },
  "agents": {
    "defaults": {
      "model": { "primary": "PLACEHOLDER_MODEL", "fallbacks": [] },
      "models": {}
    },
    "list": [
      { "id": "main", "tools": { "allow": ["web_search", "web_fetch"] } }
    ]
  },
  "bindings": [
    { "agentId": "main", "match": { "channel": "telegram", "accountId": "default" } }
  ],
  "channels": {
    "telegram": {
      "dmPolicy": "allowlist",
      "botToken": "PLACEHOLDER_TOKEN",
      "allowFrom": [0],
      "groupPolicy": "disabled"
    }
  },
  "gateway": {
    "mode": "local"
  }
}
